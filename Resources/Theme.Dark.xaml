<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- =============================================================== -->
    <!-- WPC SUTILBOX — Tema oscuro / Design System v1.2.0-beta.1      -->
    <!-- Este diccionario contiene únicamente tokens dependientes del tema. -->
    <!-- =============================================================== -->

    <!-- Accent -->
    <Color x:Key="PrimaryColor">#6366F1</Color>
    <Color x:Key="PrimaryHoverColor">#818CF8</Color>

    <!-- Superficies -->
    <Color x:Key="BackgroundColor">#0F0F1A</Color>
    <Color x:Key="SurfaceColor">#1A1A2E</Color>
    <Color x:Key="SurfaceElevatedColor">#222240</Color>
    <Color x:Key="SurfaceHoverColor">#2A2A4A</Color>

    <!-- Texto -->
    <Color x:Key="TextPrimaryColor">#F1F5F9</Color>
    <Color x:Key="TextSecondaryColor">#CBD5E1</Color>
    <Color x:Key="TextMutedColor">#64748B</Color>

    <!-- Bordes -->
    <Color x:Key="BorderColor">#334155</Color>
    <Color x:Key="BorderSubtleColor">#1E293B</Color>

    <!-- Estados semánticos -->
    <Color x:Key="SuccessColor">#10B981</Color>
    <Color x:Key="WarningColor">#F59E0B</Color>
    <Color x:Key="DangerColor">#EF4444</Color>
    <Color x:Key="InfoColor">#6366F1</Color>

    <!-- Selección -->
    <Color x:Key="SelectionColor">#406366F1</Color>

    <!-- Gradientes y efectos -->
    <Color x:Key="AccentGlowColor">#8B5CF6</Color>
    <Color x:Key="CardShadowColor">#000000</Color>

    <!-- =============================================================== -->
    <!-- Brushes canónicos                                                -->
    <!-- =============================================================== -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="SurfaceElevatedBrush" Color="{StaticResource SurfaceElevatedColor}"/>
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{StaticResource SurfaceHoverColor}"/>

    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}"/>

    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="BorderSubtleBrush" Color="{StaticResource BorderSubtleColor}"/>
    <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="{StaticResource BorderColor}"/>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}"/>
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="{StaticResource PrimaryHoverColor}"/>

    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}"/>
    <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource InfoColor}"/>

    <SolidColorBrush x:Key="SelectionBrush" Color="{StaticResource SelectionColor}"/>

    <!-- Brushes adicionales usados en vistas -->
    <SolidColorBrush x:Key="GrayBrush" Color="#64748B"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource DangerColor}"/>

    <!-- =============================================================== -->
    <!-- Gradientes y efectos visuales                                    -->
    <!-- =============================================================== -->
    <SolidColorBrush x:Key="AccentGlowBrush" Color="{StaticResource AccentGlowColor}"/>

    <!-- Gradiente principal para botones y headers -->
    <LinearGradientBrush x:Key="PrimaryGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#6366F1"/>
        <GradientStop Offset="1" Color="#8B5CF6"/>
    </LinearGradientBrush>

    <!-- Gradiente sutil para tarjetas -->
    <LinearGradientBrush x:Key="CardGradientBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#1A1A2E"/>
        <GradientStop Offset="1" Color="#16162A"/>
    </LinearGradientBrush>

    <!-- Gradiente para header -->
    <LinearGradientBrush x:Key="HeaderGradientBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Offset="0" Color="#0F0F1A"/>
        <GradientStop Offset="1" Color="#1A1A2E"/>
    </LinearGradientBrush>

    <!-- Sombra para tarjetas -->
    <DropShadowEffect x:Key="CardShadow" BlurRadius="12" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.3"/>

    <!-- Sombra suave para botones -->
    <DropShadowEffect x:Key="ButtonShadow" BlurRadius="8" ShadowDepth="2" Direction="270" Color="#6366F1" Opacity="0.25"/>

    <!-- Glow para elementos activos -->
    <DropShadowEffect x:Key="ActiveGlow" BlurRadius="15" ShadowDepth="0" Direction="0" Color="#6366F1" Opacity="0.4"/>

</ResourceDictionary>
