<UserControl x:Class="Wpc_SutilBox.Views.BackupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="900">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- SUBHEADER -->
        <Border Grid.Row="0" Margin="0,0,0,16" Padding="0,0,0,12" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="WPC-SutilBox" Foreground="{DynamicResource TextMutedBrush}" FontSize="12"/>
                <TextBlock Text=" / Backup para formatear" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" Margin="4,0"/>
            </StackPanel>
        </Border>

        <!-- CONTENIDO -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,12,20">

                <!-- TARJETA PRINCIPAL -->
                <Border Style="{StaticResource AccentCardStyle}" Margin="0,0,0,18">
                    <StackPanel Margin="0">
                        <TextBlock Text="💽 Backup para Formatear" 
                                   FontSize="22" FontWeight="Bold" 
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   Margin="0,0,0,8"/>
                        <TextBlock Text="Crea una copia de seguridad completa antes de reinstalar Windows. Incluye drivers, configuraciones Wi-Fi, lista de programas y configuraciones de usuario." 
                                   FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,16"/>

                        <!-- SELECCIÓN DE DESTINO -->
                        <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="📂 Carpeta de destino" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0"
                                            Background="{DynamicResource BackgroundBrush}"
                                            BorderBrush="{DynamicResource BorderSubtleBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6">
                                        <TextBox Text="{Binding BackupDestinationPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 Padding="10,8"
                                                 Background="Transparent"
                                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                                 BorderThickness="0"
                                                 IsReadOnly="True"/>
                                    </Border>
                                    <Button Grid.Column="1" 
                                            Content="📁 Seleccionar"
                                            Command="{Binding SelectBackupDestinationCommand}"
                                            Padding="14,8"
                                            Margin="8,0,0,0"
                                            Background="{DynamicResource PrimaryBrush}"
                                            Foreground="White"
                                            BorderThickness="0"
                                            Cursor="Hand"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- OPCIONES DE BACKUP -->
                        <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="⚙️ Qué incluir en el backup" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,10"/>
                                
                                <CheckBox Content="🧩 Controladores (Drivers)" 
                                          IsChecked="{Binding BackupDrivers, Mode=TwoWay}"
                                          Foreground="{DynamicResource TextPrimaryBrush}"
                                          FontSize="12" Margin="0,0,0,6"/>
                                
                                <CheckBox Content="📡 Configuraciones Wi-Fi" 
                                          IsChecked="{Binding BackupWifi, Mode=TwoWay}"
                                          Foreground="{DynamicResource TextPrimaryBrush}"
                                          FontSize="12" Margin="0,0,0,6"/>
                                
                                <CheckBox Content="📋 Lista de programas instalados" 
                                          IsChecked="{Binding BackupSoftware, Mode=TwoWay}"
                                          Foreground="{DynamicResource TextPrimaryBrush}"
                                          FontSize="12" Margin="0,0,0,6"/>
                                
                                <CheckBox Content="👤 Configuraciones de usuario" 
                                          IsChecked="{Binding BackupUserSettings, Mode=TwoWay}"
                                          Foreground="{DynamicResource TextPrimaryBrush}"
                                          FontSize="12" Margin="0,0,0,6"/>
                            </StackPanel>
                        </Border>

                        <!-- BOTÓN INICIAR BACKUP -->
                        <Button Content="🚀 Iniciar Copia de Seguridad"
                                Command="{Binding StartBackupCommand}"
                                Padding="16,12"
                                FontSize="14"
                                FontWeight="SemiBold"
                                Background="{DynamicResource PrimaryBrush}"
                                Foreground="White"
                                BorderThickness="0"
                                Cursor="Hand"
                                HorizontalAlignment="Left"
                                IsEnabled="{Binding IsBackupRunning, Converter={StaticResource InverseBooleanConverter}}"/>

                        <!-- BARRA DE PROGRESO -->
                        <Border Visibility="{Binding IsBackupRunning, Converter={StaticResource BooleanToVisibilityConverter}}"
                                Background="{DynamicResource SurfaceBrush}" 
                                BorderBrush="{DynamicResource BorderSubtleBrush}" 
                                BorderThickness="1" 
                                CornerRadius="8" 
                                Padding="14"
                                Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="{Binding BackupStatusMessage}" 
                                           FontSize="12" 
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           Margin="0,0,0,8"/>
                                <ProgressBar Value="{Binding BackupProgress, Mode=OneWay}" 
                                             Maximum="100"
                                             Height="8"
                                             Background="{DynamicResource BackgroundBrush}"
                                             BorderThickness="0"/>
                                <TextBlock Text="{Binding BackupProgressText}" 
                                           FontSize="11" 
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           Margin="0,6,0,0"/>
                                <Button Content="✖ Cancelar"
                                        Command="{Binding CancelBackupCommand}"
                                        Padding="10,6"
                                        Margin="0,10,0,0"
                                        Background="{DynamicResource SurfaceElevatedBrush}"
                                        Foreground="{DynamicResource TextSecondaryBrush}"
                                        BorderThickness="0"
                                        Cursor="Hand"
                                        HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Border>

                        <!-- RESULTADO DEL BACKUP -->
                        <Border Visibility="{Binding BackupCompleted, Converter={StaticResource BooleanToVisibilityConverter}}"
                                Background="#0A4A2C" 
                                BorderBrush="#10B981" 
                                BorderThickness="1" 
                                CornerRadius="8" 
                                Padding="14"
                                Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="✅ Copia de seguridad completada" 
                                           FontSize="14" 
                                           FontWeight="SemiBold"
                                           Foreground="#10B981"
                                           Margin="0,0,0,6"/>
                                <TextBlock Text="{Binding BackupResultMessage}" 
                                           FontSize="12" 
                                           Foreground="#6EE7B7"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- BACKUPS EXISTENTES -->
                <Border Style="{StaticResource AccentCardStyle}">
                    <StackPanel Margin="0">
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="📦 Backups Existentes" 
                                       FontSize="16" FontWeight="SemiBold" 
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <Button Grid.Column="1" 
                                    Content="🔄 Actualizar"
                                    Command="{Binding RefreshBackupsCommand}"
                                    Padding="10,6"
                                    Background="{DynamicResource SurfaceElevatedBrush}"
                                    Foreground="{DynamicResource TextSecondaryBrush}"
                                    BorderThickness="0"
                                    Cursor="Hand"/>
                        </Grid>

                        <ItemsControl ItemsSource="{Binding ExistingBackups}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource SurfaceBrush}" 
                                            BorderBrush="{DynamicResource BorderSubtleBrush}" 
                                            BorderThickness="1" 
                                            CornerRadius="8" 
                                            Padding="12"
                                            Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding Description}" 
                                                           FontSize="12" 
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                <TextBlock FontSize="11" 
                                                           Foreground="{DynamicResource TextMutedBrush}"
                                                           Margin="0,4,0,0">
                                                    <Run Text="Tamaño: "/>
                                                    <Run Text="{Binding TotalSize, StringFormat={}{0:N0} bytes}"/>
                                                    <Run Text=" | Items: "/>
                                                    <Run Text="{Binding ItemsCount}"/>
                                                </TextBlock>
                                                <TextBlock Text="{Binding Path, StringFormat=📂 {0}}" 
                                                           FontSize="10" 
                                                           Foreground="{DynamicResource TextMutedBrush}"
                                                           Margin="0,4,0,0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                                                <Button Content="📂"
                                                        Command="{Binding DataContext.OpenBackupFolderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding Path}"
                                                        Padding="8,6"
                                                        Margin="0,0,4,0"
                                                        Background="{DynamicResource SurfaceElevatedBrush}"
                                                        Foreground="{DynamicResource TextSecondaryBrush}"
                                                        BorderThickness="0"
                                                        Cursor="Hand"
                                                        ToolTip="Abrir carpeta"/>
                                                <Button Content="🗑️"
                                                        Command="{Binding DataContext.DeleteBackupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding Path}"
                                                        Padding="8,6"
                                                        Background="{DynamicResource SurfaceElevatedBrush}"
                                                        Foreground="{DynamicResource TextSecondaryBrush}"
                                                        BorderThickness="0"
                                                        Cursor="Hand"
                                                        ToolTip="Eliminar backup"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Visibility="{Binding ExistingBackups, Converter={StaticResource CollectionEmptyToVisibilityConverter}}"
                                   Text="No se encontraron backups existentes." 
                                   FontSize="12" 
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   FontStyle="Italic"
                                   HorizontalAlignment="Center"
                                   Margin="0,20,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
