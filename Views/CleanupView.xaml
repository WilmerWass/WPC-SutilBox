<UserControl x:Class="Wpc_SutilBox.Views.CleanupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900">
    <Grid Style="{StaticResource AnimatedViewStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="20,20,20,16">
            <TextBlock Text="🧹 Limpieza de archivos" Style="{StaticResource HeaderTextStyle}"/>
            <TextBlock Text="Revisa los candidatos antes de confirmar cualquier eliminación."
                       Style="{StaticResource SubHeaderTextStyle}" Margin="0,6,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" CornerRadius="12"
                Padding="16" Margin="20,0,20,14">
            <StackPanel>
                <WrapPanel Margin="0,0,0,12">
                    <CheckBox Content="Archivos temporales" IsChecked="{Binding CleanSystemTemp}" Margin="0,0,18,8"/>
                    <CheckBox Content="Papelera de reciclaje" IsChecked="{Binding CleanRecycleBin}" Margin="0,0,18,8"/>
                    <CheckBox Content="Caché del navegador" IsChecked="{Binding CleanBrowserCache}" Margin="0,0,18,8"/>
                    <CheckBox Content="Windows Update" IsChecked="{Binding CleanWindowsUpdate}" Margin="0,0,18,8"/>
                    <CheckBox Content="Miniaturas" IsChecked="{Binding CleanThumbnails}" Margin="0,0,18,8"/>
                    <CheckBox Content="Registros de eventos" IsChecked="{Binding CleanEventLogs}" Margin="0,0,18,8"/>
                </WrapPanel>
                <WrapPanel>
                    <Button Content="Analizar candidatos" Command="{Binding PreviewCommand}"
                            Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,10,8"/>
                    <Button Content="Cancelar" Command="{Binding CancelCommand}"
                            IsEnabled="{Binding IsBusy}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,8"/>
                    <Button Content="Eliminar seleccionados" Command="{Binding CleanCommand}"
                            IsEnabled="{Binding HasCleanupCandidates}"
                            Style="{StaticResource DangerButtonStyle}" Margin="0,0,10,8"/>
                    <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,8"/>
                </WrapPanel>
                <ProgressBar Height="3" IsIndeterminate="True"
                             Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"
                             Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <DataGrid Grid.Row="2" ItemsSource="{Binding CleanupCandidates}" AutoGenerateColumns="False"
                  IsReadOnly="True" CanUserAddRows="False" Margin="20,0,20,20"
                  HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Ruta a revisar" Binding="{Binding Path}" Width="*"/>
                <DataGridTextColumn Header="Tamaño estimado"
                                    Binding="{Binding SizeBytes, Converter={StaticResource BytesToHumanReadableConverter}}"
                                    Width="160"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
