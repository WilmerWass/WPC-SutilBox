<UserControl x:Class="Wpc_SutilBox.Views.PcReviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="Revisar mi PC" Style="{StaticResource HeaderTextStyle}"/>
            <TextBlock Text="Diagnóstico centralizado de salud, hardware, almacenamiento y procesos." Style="{StaticResource SubHeaderTextStyle}" Margin="0,5,0,0"/>
        </StackPanel>
        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">
            <TabItem Header="Resumen de salud">
                <UniformGrid Columns="3" Margin="0,12,0,0">
                    <Border Style="{StaticResource AnimatedCardStyle}" Margin="0,0,10,10"><StackPanel><TextBlock Text="CPU" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBlock Text="{Binding CpuUsage, Mode=OneWay, StringFormat={}{0:F0}%}" FontSize="30" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="Bold"/></StackPanel></Border>
                    <Border Style="{StaticResource AnimatedCardStyle}" Margin="0,0,10,10"><StackPanel><TextBlock Text="RAM" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBlock Text="{Binding RamUsage, Mode=OneWay, StringFormat={}{0:F0}%}" FontSize="30" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="Bold"/></StackPanel></Border>
                    <Border Style="{StaticResource AnimatedCardStyle}" Margin="0,0,10,10"><StackPanel><TextBlock Text="Temperatura" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBlock Text="{Binding CpuTempC, Mode=OneWay, StringFormat={}{0:F0} °C}" FontSize="30" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="Bold"/></StackPanel></Border>
                </UniformGrid>
            </TabItem>
            <TabItem Header="Espacio y almacenamiento">
                <StackPanel Margin="0,20"><TextBlock Text="Análisis de almacenamiento" FontSize="20" Foreground="{DynamicResource TextPrimaryBrush}"/><TextBlock Text="La gestión detallada de limpieza y archivos grandes está disponible en Liberar espacio." Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,8,0,20"/><Button Content="Abrir Liberar espacio" Command="{Binding NavigateCommand}" CommandParameter="Almacenamiento" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Left"/></StackPanel>
            </TabItem>
            <TabItem Header="Hardware y temperaturas">
                <StackPanel Margin="0,20"><TextBlock Text="Hardware y temperaturas" FontSize="20" Foreground="{DynamicResource TextPrimaryBrush}"/><StackPanel Orientation="Horizontal" Margin="0,12,0,4"><TextBlock Text="CPU: " Foreground="{DynamicResource TextSecondaryBrush}"/><TextBlock Text="{Binding CpuTempC, StringFormat={}{0:F0} °C}" Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel><StackPanel Orientation="Horizontal"><TextBlock Text="Uso de CPU: " Foreground="{DynamicResource TextSecondaryBrush}"/><TextBlock Text="{Binding CpuUsage, StringFormat={}{0:F0}%}" Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel><StackPanel Orientation="Horizontal" Margin="0,4,0,0"><TextBlock Text="Uso de RAM: " Foreground="{DynamicResource TextSecondaryBrush}"/><TextBlock Text="{Binding RamUsage, StringFormat={}{0:F0}%}" Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel></StackPanel>
            </TabItem>
            <TabItem Header="Procesos de alto consumo">
                <Grid Margin="0,12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Button Content="Actualizar procesos" Command="{Binding RefreshProcessesCommand}" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Right" Margin="0,0,0,10"/><DataGrid Grid.Row="1" ItemsSource="{Binding Processes}" AutoGenerateColumns="False" CanUserAddRows="False" Background="Transparent" Foreground="{DynamicResource TextPrimaryBrush}"><DataGrid.Columns><DataGridTextColumn Header="Proceso" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="RAM (MB)" Binding="{Binding WorkingSetMb, StringFormat={}{0:F1}}" Width="120"/><DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="80"/></DataGrid.Columns></DataGrid></Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
