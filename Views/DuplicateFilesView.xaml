<UserControl x:Class="Wpc_SutilBox.Views.DuplicateFilesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="550" d:DesignWidth="800">
    <Grid Style="{StaticResource AnimatedViewStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="20,20,20,12">
            <TextBlock Text="Archivos duplicados" Style="{StaticResource HeaderTextStyle}"/>
            <TextBlock Text="Compara los archivos por tamaño y contenido SHA-256 para localizar coincidencias exactas."
                       Style="{StaticResource SubHeaderTextStyle}" Margin="0,6,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" CornerRadius="8"
                Padding="14" Margin="20,0,20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Text="{Binding SelectedFolder, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,8,0"
                         ToolTip="Carpeta raíz del análisis"/>
                <Button Grid.Column="1" Content="Elegir carpeta" Command="{Binding BrowseCommand}"
                        Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" Padding="12,6"/>
                <Button Grid.Column="2" Content="Analizar" Command="{Binding ScanCommand}"
                        IsEnabled="{Binding CanScan}"
                        Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,0" Padding="14,6"/>
                <Button Grid.Column="3" Content="Cancelar" Command="{Binding CancelCommand}"
                        IsEnabled="{Binding IsBusy}"
                        Style="{StaticResource SecondaryButtonStyle}" Padding="12,6"/>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="20,0,20,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="{Binding StatusMessage}"
                       Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,10"/>
            <ProgressBar Grid.Row="1" Height="3" Margin="0,0,0,8" IsIndeterminate="True"
                         Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            <DataGrid Grid.Row="2" ItemsSource="{Binding DuplicateFiles}" AutoGenerateColumns="False"
                      IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Grupo" Binding="{Binding GroupNumber}" Width="65"/>
                    <DataGridTextColumn Header="Archivo" Binding="{Binding Path}" Width="2*"/>
                    <DataGridTextColumn Header="Tamaño (bytes)" Binding="{Binding SizeBytes, StringFormat=N0}" Width="120"/>
                    <DataGridTextColumn Header="SHA-256" Binding="{Binding Hash}" Width="2*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
</UserControl>
