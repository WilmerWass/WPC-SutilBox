<UserControl x:Class="Wpc_SutilBox.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             mc:Ignorable="d"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:models="clr-namespace:Wpc_SutilBox.Models"
             d:DesignHeight="700" d:DesignWidth="920">
    <Grid Style="{StaticResource AnimatedViewStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ============================================ -->
        <!-- BARRA SUPERIOR — Saludo + Métricas rápidas   -->
        <!-- ============================================ -->
        <Border Grid.Row="0"
                Margin="0,0,0,16"
                Padding="0,0,0,12"
                BorderBrush="{DynamicResource BorderSubtleBrush}"
                BorderThickness="0,0,0,1">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding GreetingMessage, TargetNullValue='Bienvenido'}"
                                   FontSize="21"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="{Binding StatusMessage}"
                                   Margin="0,3,0,0"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextMutedBrush}"/>
                    </StackPanel>
                    <Button Grid.Column="1"
                            Content="🔄 Actualizar"
                            Command="{Binding RefreshCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Padding="12,6"
                            VerticalAlignment="Center"/>
                </Grid>

                <!-- Métricas compactas en línea -->
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <!-- CPU -->
                    <Border Padding="12,8"
                            Margin="0,0,8,0"
                            CornerRadius="8"
                            Background="{DynamicResource SurfaceElevatedBrush}"
                            BorderBrush="{DynamicResource BorderSubtleBrush}"
                            BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🖥️" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <StackPanel>
                                <TextBlock Text="CPU" FontSize="10" Foreground="{DynamicResource TextMutedBrush}"/>
                                <TextBlock Text="{Binding CpuUsage, StringFormat={}{0:F0}%}"
                                           FontSize="14" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <!-- RAM -->
                    <Border Padding="12,8"
                            Margin="0,0,8,0"
                            CornerRadius="8"
                            Background="{DynamicResource SurfaceElevatedBrush}"
                            BorderBrush="{DynamicResource BorderSubtleBrush}"
                            BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="💾" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <StackPanel>
                                <TextBlock Text="RAM" FontSize="10" Foreground="{DynamicResource TextMutedBrush}"/>
                                <TextBlock Text="{Binding RamUsage, StringFormat={}{0:F0}%}"
                                           FontSize="14" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <!-- Disco -->
                    <Border Padding="12,8"
                            Margin="0,0,8,0"
                            CornerRadius="8"
                            Background="{DynamicResource SurfaceElevatedBrush}"
                            BorderBrush="{DynamicResource BorderSubtleBrush}"
                            BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="💿" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <StackPanel>
                                <TextBlock Text="Disco" FontSize="10" Foreground="{DynamicResource TextMutedBrush}"/>
                                <TextBlock Text="{Binding DiskUsageText, TargetNullValue='--'}"
                                           FontSize="14" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <!-- Temperatura -->
                    <Border Padding="12,8"
                            CornerRadius="8"
                            Background="{DynamicResource SurfaceElevatedBrush}"
                            BorderBrush="{DynamicResource BorderSubtleBrush}"
                            BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🌡️" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <StackPanel>
                                <TextBlock Text="Temp" FontSize="10" Foreground="{DynamicResource TextMutedBrush}"/>
                                <TextBlock Text="{Binding CpuTempText, TargetNullValue='No disp.'}"
                                           FontSize="14" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ============================================ -->
        <!-- CONTENIDO PRINCIPAL                          -->
        <!-- ============================================ -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,12,20">

                <!-- ============================================ -->
                <!-- TARJETA DE SALUD — Score principal           -->
                <!-- ============================================ -->
                <Border Style="{StaticResource AccentCardStyle}"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="🔬 Salud de tu PC"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding HealthScoreDisplay}"
                                               FontSize="36"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <ProgressBar Grid.Column="1"
                                                 Margin="12,6,0,0"
                                                 Width="200"
                                                 Height="12"
                                                 Value="{Binding HealthScore, Mode=OneWay, TargetNullValue=0, FallbackValue=0}"
                                                 Maximum="100"
                                                 Foreground="{DynamicResource SuccessBrush}"
                                                 Background="{DynamicResource SurfaceBrush}"
                                                 BorderThickness="0"/>
                                </Grid>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <TextBlock Text="✅ " FontSize="12" Foreground="{DynamicResource SuccessBrush}"/>
                                    <TextBlock Text="{Binding HealthChecksOk, StringFormat={}OK: {0}}"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               Margin="0,0,12,0"/>
                                    <TextBlock Text="⚠️ " FontSize="12" Foreground="{DynamicResource WarningBrush}"/>
                                    <TextBlock Text="{Binding HealthWarnings, StringFormat={}Advertencias: {0}}"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               Margin="0,0,12,0"/>
                                    <TextBlock Text="❌ " FontSize="12" Foreground="{DynamicResource DangerBrush}"/>
                                    <TextBlock Text="{Binding HealthCritical, StringFormat={}Críticos: {0}}"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <Button Content="🔍 Ejecutar Escáner"
                                        Command="{Binding QuickScanCommand}"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Padding="14,8"
                                        Margin="0,0,8,0"/>
                                <Button Content="📋 Ver Detalles"
                                        Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="RevisarPC"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Padding="14,8"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ============================================ -->
                <!-- ACCIONES RÁPIDAS — Grid 4x2                  -->
                <!-- ============================================ -->
                <TextBlock Text="⚡ Acciones rápidas"
                           Margin="0,0,0,10"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <UniformGrid Columns="4" Margin="0,0,0,16">
                    <!-- Limpieza Rápida -->
                    <Button Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="Limpieza"
                            Margin="0,0,8,8" Cursor="Hand"
                            Background="{DynamicResource CardGradientBrush}"
                            BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="16">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="🧹" FontSize="28" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                            <TextBlock Text="Limpieza" FontSize="12" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="Rápida" FontSize="10"
                                       HorizontalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}"/>
                        </StackPanel>
                    </Button>
                    <!-- Analizar almacenamiento -->
                    <Button Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="Almacenamiento"
                            Margin="0,0,8,8" Cursor="Hand"
                            Background="{DynamicResource CardGradientBrush}"
                            BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="16">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="📊" FontSize="28" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                            <TextBlock Text="Analizar" FontSize="12" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="almacenamiento" FontSize="10"
                                       HorizontalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}"/>
                        </StackPanel>
                    </Button>
                    <!-- Mapa de almacenamiento -->
                    <Button Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="MapaEspacio"
                            Margin="0,0,8,8" Cursor="Hand"
                            Background="{DynamicResource CardGradientBrush}"
                            BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="16">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="🗺️" FontSize="28" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                            <TextBlock Text="Mapa de espacio" FontSize="12" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </StackPanel>
                    </Button>
                    <!-- Archivos duplicados -->
                    <Button Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="ArchivosDuplicados"
                            Margin="0,0,0,8" Cursor="Hand"
                            Background="{DynamicResource CardGradientBrush}"
                            BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="16">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="📄" FontSize="28" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                            <TextBlock Text="Archivos" FontSize="12" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="duplicados" FontSize="10"
                                       HorizontalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}"/>
                        </StackPanel>
                    </Button>
                    <!-- Inicio de Windows -->
                    <Button Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="InicioWindows"
                            Margin="0,0,8,0" Cursor="Hand"
                            Background="{DynamicResource CardGradientBrush}"
                            BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="16">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="🚀" FontSize="28" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                            <TextBlock Text="Inicio" FontSize="12" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="Windows" FontSize="10"
                                       HorizontalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}"/>
                        </StackPanel>
                    </Button>
                    <!-- Desinstalador -->
                    <Button Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="Desinstalador"
                            Margin="0,0,8,0" Cursor="Hand"
                            Background="{DynamicResource CardGradientBrush}"
                            BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="16">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="📦" FontSize="28" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                            <TextBlock Text="Programas" FontSize="12" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </StackPanel>
                    </Button>
                    <!-- Escáner -->
                    <Button Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="Escaneo"
                            Margin="0,0,8,0" Cursor="Hand"
                            Background="{DynamicResource CardGradientBrush}"
                            BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="16">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="🔬" FontSize="28" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                            <TextBlock Text="Escáner" FontSize="12" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </StackPanel>
                    </Button>
                    <!-- Optimizaciones -->
                    <Button Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="Optimizaciones"
                            Margin="0,0,0,0" Cursor="Hand"
                            Background="{DynamicResource CardGradientBrush}"
                            BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="16">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="🔧" FontSize="28" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                            <TextBlock Text="Optimizar" FontSize="12" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </StackPanel>
                    </Button>
                </UniformGrid>

                <!-- ============================================ -->
                <!-- ALERTAS Y RECOMENDACIONES                    -->
                <!-- ============================================ -->
                <Border Margin="0,0,0,16">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Alerts.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Text="⚠️ Recomendaciones"
                                   Margin="0,0,0,10"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <ItemsControl ItemsSource="{Binding Alerts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="12"
                                            Margin="0,0,0,8"
                                            CornerRadius="8"
                                            Background="{DynamicResource SurfaceElevatedBrush}"
                                            BorderBrush="{DynamicResource BorderSubtleBrush}"
                                            BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="SeverityIcon"
                                                       FontSize="16"
                                                       Margin="0,0,10,0"
                                                       VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Title}"
                                                           FontSize="13"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                <TextBlock Text="{Binding Description}"
                                                           Margin="0,2,0,0"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <Button Grid.Column="2"
                                                    x:Name="ActionButton"
                                                    Content="{Binding ActionLabel}"
                                                    Style="{StaticResource PrimaryButtonStyle}"
                                                    Padding="10,6"
                                                    Margin="10,0,0,0"
                                                    VerticalAlignment="Center"
                                                    Visibility="Collapsed"/>
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Severity}" Value="Critical">
                                            <Setter TargetName="SeverityIcon" Property="Text" Value="🔴"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Severity}" Value="Warning">
                                            <Setter TargetName="SeverityIcon" Property="Text" Value="🟡"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Severity}" Value="Info">
                                            <Setter TargetName="SeverityIcon" Property="Text" Value="🔵"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ActionLabel}" Value="">
                                            <Setter TargetName="ActionButton" Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- ============================================ -->
                <!-- ACTIVIDAD RECIENTE                           -->
                <!-- ============================================ -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="📋 Actividad reciente"
                                   Margin="0,0,0,10"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <ItemsControl ItemsSource="{Binding RecentActivities}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding StatusIcon}"
                                                   FontSize="14"
                                                   Margin="0,0,8,0"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Timestamp, StringFormat={}{0:HH:mm}}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   Margin="0,0,12,0"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding Title}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="3"
                                                   Text="{Binding Description}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   Margin="8,0,0,0"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                            <ItemsControl.Style>
                                <Style TargetType="ItemsControl">
                                    <Style.Triggers>
                                        <Trigger Property="HasItems" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ItemsControl.Style>
                        </ItemsControl>
                        <TextBlock Text="No hay actividad reciente."
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   FontSize="12"
                                   Margin="0,8,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding RecentActivities.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
