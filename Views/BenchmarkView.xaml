<UserControl x:Class="Wpc_SutilBox.Views.BenchmarkView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="550" d:DesignWidth="800">
    <Grid Style="{StaticResource AnimatedViewStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="20,20,20,12">
            <TextBlock Text="Benchmark de CPU y memoria" Style="{StaticResource HeaderTextStyle}"/>
            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource SubHeaderTextStyle}"
                       Margin="0,6,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" CornerRadius="8"
                Padding="12" Margin="20,0,20,16">
            <TextBlock Text="Prueba breve de CPU y memoria RAM. No mide GPU ni rendimiento de almacenamiento y no crea archivos. Los resultados son orientativos, no comparables con suites de benchmark estandarizadas."
                       Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
        </Border>

        <UniformGrid Grid.Row="2" Columns="2" Margin="20,0,20,20">
            <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="10" Padding="18" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="CPU · cálculo de primos (2 s)"
                               Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13"/>
                    <TextBlock Text="{Binding CpuResult}" Foreground="{DynamicResource TextPrimaryBrush}"
                               FontSize="21" FontWeight="SemiBold" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
            <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="10" Padding="18" Margin="8,0,0,0">
                <StackPanel>
                    <TextBlock Text="Memoria · copia en RAM"
                               Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13"/>
                    <TextBlock Text="{Binding MemoryResult}" Foreground="{DynamicResource TextPrimaryBrush}"
                               FontSize="21" FontWeight="SemiBold" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center"
                    VerticalAlignment="Top">
            <Button Content="Iniciar prueba" Command="{Binding RunCommand}" IsEnabled="{Binding CanRun}"
                    Style="{StaticResource PrimaryButtonStyle}" Padding="18,9" Margin="0,0,8,0"/>
            <Button Content="Cancelar" Command="{Binding CancelCommand}" IsEnabled="{Binding IsBusy}"
                    Style="{StaticResource SecondaryButtonStyle}" Padding="18,9"/>
        </StackPanel>
    </Grid>
</UserControl>
