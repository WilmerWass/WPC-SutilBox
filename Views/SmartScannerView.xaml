<UserControl x:Class="Wpc_SutilBox.Views.SmartScannerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:Wpc_SutilBox.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="920"
             d:DataContext="{d:DesignInstance Type=vm:SmartScannerViewModel}">

    <UserControl.Resources>
        <!-- Severity to color converter using DataTriggers -->
        <Style x:Key="IssueCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="BorderThickness" Value="1,1,1,3"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
    </UserControl.Resources>

    <Grid Style="{StaticResource AnimatedViewStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- TOP BAR -->
        <Border Grid.Row="0" Margin="0,0,0,16" Padding="0,0,0,12" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="WPC-SutilBox" Foreground="{DynamicResource TextMutedBrush}" FontSize="12"/>
                    <TextBlock Text=" / " Foreground="{DynamicResource TextMutedBrush}" FontSize="12" Margin="4,0"/>
                    <TextBlock Text="🔬 Escáner Inteligente" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="🗑️ Limpiar" 
                            Command="{Binding ClearResultsCommand}" 
                            Style="{StaticResource SecondaryButtonStyle}" 
                            Padding="12,4" FontSize="11" Margin="0,0,8,0"/>
                    <Button Content="📄 Exportar Reporte" 
                            Command="{Binding ExportReportCommand}" 
                            Style="{StaticResource SecondaryButtonStyle}" 
                            Padding="12,4" FontSize="11"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN CONTENT -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,12,20">

                <!-- SCAN ACTION CARD -->
                <Border Background="{DynamicResource SurfaceBrush}" 
                        BorderBrush="{DynamicResource PrimaryBrush}" 
                        BorderThickness="1,1,1,3" 
                        CornerRadius="16" 
                        Padding="24" 
                        Margin="0,0,0,18">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,20,0">
                            <TextBlock Text="🔬 Escáner Inteligente" 
                                       FontSize="20" FontWeight="Bold" 
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="Analiza tu sistema completo y detecta problemas de rendimiento, seguridad, drivers y más."
                                       FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" 
                                       Margin="0,6,0,0"/>
                            <TextBlock Text="{Binding StatusMessage}"
                                       FontSize="12" Foreground="{DynamicResource TextMutedBrush}" 
                                       Margin="0,8,0,0" TextWrapping="Wrap"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Width="260">
                            <!-- Progress Bar -->
                            <ProgressBar Value="{Binding Progress}" Maximum="100" 
                                         Height="8" Margin="0,0,0,12" 
                                         Visibility="{Binding IsScanning, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                            <!-- Health Score -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,12">
                                <Border Width="60" Height="60" CornerRadius="30" 
                                        BorderBrush="{DynamicResource PrimaryBrush}" BorderThickness="4"
                                        VerticalAlignment="Center">
                                    <Grid>
                                        <TextBlock Text="{Binding HealthScore}" 
                                                   FontSize="16" FontWeight="Bold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                                <TextBlock Text="/100" FontSize="14" Foreground="{DynamicResource TextMutedBrush}" 
                                           VerticalAlignment="Center" Margin="8,0,0,0"/>
                            </StackPanel>

                            <!-- Scan Button -->
                            <Button Command="{Binding StartScanCommand}" 
                                    Style="{StaticResource PrimaryButtonStyle}" 
                                    Height="48" 
                                    HorizontalAlignment="Stretch">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🔬   Iniciar Escáner" FontWeight="Bold" FontSize="14"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- FILTERS -->
                <Border Background="{DynamicResource SurfaceBrush}" 
                        BorderBrush="{DynamicResource BorderSubtleBrush}" 
                        BorderThickness="1" 
                        CornerRadius="12" 
                        Padding="16" 
                        Margin="0,0,0,16"
                        Visibility="{Binding IsScanning, Converter={StaticResource InvertedBooleanToVisibilityConverter}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <TextBlock Text="Categoría" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4"/>
                            <ComboBox ItemsSource="{Binding CategoryFilters}" 
                                      SelectedItem="{Binding FilterCategory}" 
                                      Style="{StaticResource ModernComboBoxStyle}"
                                      Height="32"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Severidad" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4"/>
                            <ComboBox ItemsSource="{Binding SeverityFilters}" 
                                      SelectedItem="{Binding FilterSeverity}" 
                                      Style="{StaticResource ModernComboBoxStyle}"
                                      Height="32"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ISSUES LIST -->
                <ItemsControl ItemsSource="{Binding FilteredIssues}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border>
                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource IssueCardStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Severity}" Value="Critical">
                                                <Setter Property="BorderBrush" Value="#EF4444"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Severity}" Value="Warning">
                                                <Setter Property="BorderBrush" Value="#F59E0B"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Severity}" Value="Info">
                                                <Setter Property="BorderBrush" Value="#3B82F6"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Severity Icon -->
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,14,0">
                                        <TextBlock FontSize="20">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="ℹ️"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Severity}" Value="Critical">
                                                            <Setter Property="Text" Value="🔴"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Severity}" Value="Warning">
                                                            <Setter Property="Text" Value="🟡"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>

                                    <!-- Issue Details -->
                                    <StackPanel Grid.Column="1">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" 
                                                       FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text="{Binding Category}" FontSize="10" 
                                                       Foreground="{DynamicResource TextMutedBrush}" 
                                                       Margin="8,0,0,0" 
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Description}" FontSize="12" 
                                                   Foreground="{DynamicResource TextSecondaryBrush}" 
                                                   Margin="0,4,0,0" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Solution}" FontSize="11" 
                                                   Foreground="{DynamicResource TextMutedBrush}" 
                                                   Margin="0,6,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>

                                    <!-- Solve Button -->
                                    <Button Grid.Column="2" VerticalAlignment="Top"
                                            Content="Solucionar" 
                                            Command="{Binding DataContext.SolveIssueCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Padding="12,6" FontSize="11"
                                            Visibility="{Binding IsSolvable, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- EMPTY STATE -->
                <Border Background="{DynamicResource SurfaceBrush}" 
                        BorderBrush="{DynamicResource BorderSubtleBrush}" 
                        BorderThickness="1" 
                        CornerRadius="16" 
                        Padding="40"
                        Visibility="{Binding IsScanning, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="🔬" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                        <TextBlock Text="No se ha ejecutado ningún escaneo" 
                                   FontSize="16" FontWeight="SemiBold" 
                                   Foreground="{DynamicResource TextPrimaryBrush}" 
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Presiona 'Iniciar Escáner' para analizar tu sistema completo."
                                   FontSize="12" Foreground="{DynamicResource TextMutedBrush}" 
                                   HorizontalAlignment="Center" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
