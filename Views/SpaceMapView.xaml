<UserControl x:Class="Wpc_SutilBox.Views.SpaceMapView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:Wpc_SutilBox.Models"
             xmlns:core="clr-namespace:Wpc_SutilBox.Core"
             Background="{DynamicResource BackgroundBrush}">
    <UserControl.Resources><ItemsPanelTemplate x:Key="TreemapItemsPanel"><core:SpaceTreemapPanel/></ItemsPanelTemplate></UserControl.Resources>
    <Grid x:Name="RootLayout" Margin="20" MinWidth="0" MinHeight="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                <TextBlock Text="Mapa de espacio" Style="{StaticResource HeaderTextStyle}" TextWrapping="Wrap"/>
                <TextBlock Text="Explora el tamaño de tus carpetas y localiza archivos grandes o antiguos." Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"/>
            </StackPanel>
            <Button Grid.Column="1" Content="← Volver" Command="{Binding BackCommand}" Style="{StaticResource SecondaryButtonStyle}" VerticalAlignment="Top"/>
        </Grid>
        <Border Grid.Row="1" Style="{StaticResource AnimatedCardStyle}" Margin="0,0,0,12" Padding="12">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" MinWidth="0" Text="{Binding SelectedFolder, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" Margin="0,0,8,0" ToolTip="Carpeta elegida para analizar"/>
                <Button Grid.Column="1" Content="Elegir carpeta" Command="{Binding BrowseCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"/>
                <Button Grid.Column="2" Content="Analizar" Command="{Binding AnalyzeCommand}" Style="{StaticResource PrimaryButtonStyle}" IsEnabled="{Binding IsScanning, Converter={StaticResource InverseBoolConverter}}" Margin="0,0,8,0"/>
                <Button Grid.Column="3" Content="Cancelar" Command="{Binding CancelCommand}" Style="{StaticResource SecondaryButtonStyle}" IsEnabled="{Binding IsScanning}"/>
            </Grid>
        </Border>
        <Grid Grid.Row="2" MinWidth="0" MinHeight="0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="1.4*"/></Grid.ColumnDefinitions>
            <Grid Grid.Column="0" Margin="0,0,8,0" MinWidth="0" MinHeight="0">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Mapa jerárquico · Archivos grandes y antiguos" FontSize="17" FontWeight="SemiBold" Foreground="White" Margin="2,0,2,10" TextWrapping="Wrap"/>
                <Border Grid.Row="1" Style="{StaticResource AnimatedCardStyle}" Padding="8" MinWidth="0" MinHeight="0">
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Roots}">
                            <ItemsControl.ItemTemplate><DataTemplate>
                                <StackPanel Margin="0,0,0,10">
                                    <TextBlock Text="{Binding Name}" ToolTip="{Binding Path}" Foreground="White" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding FormattedSize}" Foreground="{DynamicResource PrimaryBrush}" Margin="0,0,0,6"/>
                                    <ItemsControl ItemsSource="{Binding Children}" ItemsPanel="{StaticResource TreemapItemsPanel}">
                                        <ItemsControl.ItemTemplate><DataTemplate>
                                            <Border Background="{DynamicResource SurfaceElevatedBrush}" BorderBrush="{DynamicResource PrimaryBrush}" BorderThickness="1" CornerRadius="4" Margin="1" Padding="3" MinHeight="48" ToolTip="{Binding Path}">
                                                <Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="{Binding Name}" Foreground="White" TextTrimming="CharacterEllipsis" FontSize="10"/><TextBlock Grid.Row="1" Text="{Binding FormattedSize}" Foreground="{DynamicResource PrimaryBrush}" FontSize="9" TextTrimming="CharacterEllipsis"/></Grid>
                                            </Border>
                                        </DataTemplate></ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
            </Grid>
            <Grid Grid.Column="1" Margin="8,0,0,0" MinWidth="0" MinHeight="0">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Margin="4,0,4,8"><TextBlock Text="Archivos encontrados" FontSize="17" FontWeight="SemiBold" Foreground="White" TextWrapping="Wrap"/><TextBlock Text="Ordena por tamaño o fecha; abre la ubicación o selecciona archivos." Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" TextWrapping="Wrap"/></StackPanel>
                <DataGrid Grid.Row="1" MinWidth="0" ItemsSource="{Binding Files}" AutoGenerateColumns="False" IsReadOnly="False" CanUserSortColumns="True" SelectionMode="Extended" HeadersVisibility="Column" EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True" HorizontalScrollBarVisibility="Auto">
                    <DataGrid.Columns>
                        <DataGridCheckBoxColumn Header="✓" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="36"/>
                        <DataGridTextColumn Header="Nombre" Binding="{Binding Name}" Width="*" MinWidth="90" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Categoría" Binding="{Binding Category}" Width="85" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Tamaño" Binding="{Binding FormattedSize}" Width="75" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Modificado" Binding="{Binding LastModified, StringFormat={}{0:yyyy-MM-dd}}" Width="90" IsReadOnly="True"/>
                        <DataGridTemplateColumn Header="Ruta" Width="55"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="Abrir" Command="{Binding DataContext.OpenLocationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource SecondaryButtonStyle}" Padding="3,2"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <Grid Grid.Row="2" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding Status}" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,8,0"/>
                    <Button Grid.Column="1" Content="Borrar seleccionados" Command="{Binding DeleteSelectedCommand}" Style="{StaticResource SecondaryButtonStyle}" Background="#552222" Foreground="#FF9999" MaxWidth="170"/>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
