<UserControl x:Class="Wpc_SutilBox.Views.CleaningView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="1000"
             Background="{DynamicResource BackgroundBrush}">
    <UserControl.DataContext>
        <Binding Path="DataContext.StorageViewModel" RelativeSource="{RelativeSource AncestorType=Window}"/>
    </UserControl.DataContext>

    <Grid Background="{DynamicResource BackgroundBrush}" ClipToBounds="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Liberar espacio" Style="{StaticResource HeaderTextStyle}"
                   Margin="20,16,20,12"/>

        <Grid Grid.Row="1" Margin="20,0,20,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="35*"/>
                <ColumnDefinition Width="65*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource AnimatedCardStyle}" Padding="16" Margin="0,0,12,0"
                    VerticalAlignment="Stretch">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Unidad o carpeta" Style="{StaticResource HeaderTextStyle}" FontSize="16"/>
                    <ComboBox Grid.Row="1" ItemsSource="{Binding Volumes}" SelectedItem="{Binding SelectedVolume}"
                              DisplayMemberPath="Name" Margin="0,12,0,8"/>
                    <Button Grid.Row="2" Content="Elegir carpeta" Command="{Binding BrowseFolderCommand}"
                            Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Stretch" Margin="0,0,0,10"/>
                    <TextBlock Grid.Row="3" Text="{Binding SelectedPath}" Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap" Margin="0,0,0,12" ToolTip="{Binding SelectedPath}"/>

                    <StackPanel Grid.Row="4" VerticalAlignment="Top">
                        <Button Content="Actualizar unidades" Command="{Binding RefreshVolumesCommand}"
                                Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Stretch" Margin="0,0,0,8"/>
                        <Button Content="Analizar" Command="{Binding ScanCommand}"
                                Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Stretch" Margin="0,0,0,8"/>
                        <Button Content="Cancelar" Command="{Binding CancelCommand}"
                                Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Stretch" Margin="0,0,0,8"/>
                        <Button Content="🗺️   Mapa de espacio" Command="{Binding DataContext.OpenSpaceMapCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Stretch" ToolTip="Visualiza el mapa jerárquico de espacio en disco"/>
                    </StackPanel>

                    <Border Grid.Row="5" Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Padding="12" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="Espacio analizado" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding FormattedTotalBytes}" Foreground="{DynamicResource PrimaryBrush}"
                                       FontSize="24" FontWeight="Bold" Margin="0,4,0,0"/>
                            <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" Margin="0,8,0,0"/>
                            <TextBlock Text="{Binding FilesScanned, StringFormat={}{0:N0} archivos}"
                                       Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,0"/>
                            <TextBlock Text="{Binding DirectoriesScanned, StringFormat={}{0:N0} carpetas}"
                                       Foreground="{DynamicResource TextMutedBrush}"/>
                            <TextBlock Text="Resultado parcial" Foreground="{DynamicResource WarningBrush}"
                                       Visibility="{Binding IsPartial, Converter={StaticResource BooleanToVisibilityConverter}}"
                                       Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,10" LastChildFill="True">
                    <TextBox DockPanel.Dock="Right" Width="220" Margin="8,0,0,0" Padding="8,4"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Filtrar por ruta"/>
                    <TextBlock Text="Archivos y carpetas encontrados" Style="{StaticResource HeaderTextStyle}"
                               FontSize="16" VerticalAlignment="Center"/>
                </DockPanel>

                <DataGrid Grid.Row="1" ItemsSource="{Binding FilteredItems}" AutoGenerateColumns="False"
                          IsReadOnly="True" CanUserAddRows="False" EnableRowVirtualization="True"
                          EnableColumnVirtualization="True" HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Nombre" Binding="{Binding Name}" Width="2*"/>
                        <DataGridTextColumn Header="Ruta" Binding="{Binding Path}" Width="4*"/>
                        <DataGridTextColumn Header="Tipo" Binding="{Binding Extension}" Width="*"/>
                        <DataGridTextColumn Header="Tamaño"
                            Binding="{Binding SizeBytes, Converter={StaticResource BytesToHumanReadableConverter}}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>

                <Expander Grid.Row="2" Header="Incidencias y alertas de acceso" IsExpanded="False"
                          Foreground="{DynamicResource WarningBrush}" Margin="0,8,0,0">
                    <Border Background="{DynamicResource SurfaceBrush}" Padding="8" MaxHeight="120">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Errors}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Path, StringFormat='{}Incidencia: {0}'}"
                                                   Foreground="{DynamicResource WarningBrush}"
                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Message}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </Expander>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
