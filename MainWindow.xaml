<Window x:Class="Wpc_SutilBox.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:Wpc_SutilBox.Views"
        xmlns:enums="clr-namespace:Wpc_SutilBox.Models"
        mc:Ignorable="d"
        Title="WPC-SutilBox"
        Height="700"
        Width="1180"
        MinHeight="560"
        MinWidth="900"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResize"
        WindowState="Normal"
        WindowStartupLocation="CenterScreen"
        ShowActivated="True"
        Topmost="False"
        Icon="Resources/img/logo_WCS.ico"
        Background="{DynamicResource BackgroundBrush}">

    <Border Background="{DynamicResource BackgroundBrush}">

        <Grid>

            <!-- ========================================================= -->
            <!-- ESTRUCTURA PRINCIPAL                                      -->
            <!-- ========================================================= -->

            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="235"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ========================================================= -->
            <!-- SIDEBAR ÚNICO Y UNIFICADO                                 -->
            <!-- ========================================================= -->

            <Border Grid.Column="0"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                    BorderThickness="0,0,1,0">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- BOTÓN CONTRAER / EXPANDIR -->
                    <Grid Grid.Row="0" Margin="18,18,18,12">
                        <TextBlock Text="WPC SutilBox" 
                                   FontSize="16" 
                                   FontWeight="Bold" 
                                   Foreground="{DynamicResource TextPrimaryBrush}" 
                                   VerticalAlignment="Center" 
                                   HorizontalAlignment="Left"/>
                        
                        <Button Width="36"
                                Height="36"
                                HorizontalAlignment="Right"
                                Content="☰"
                                ToolTip="Expandir / contraer menú"
                                Background="{DynamicResource SurfaceElevatedBrush}"
                                Foreground="{DynamicResource TextSecondaryBrush}"
                                BorderThickness="0"
                                Cursor="Hand"
                                Click="ToggleSidebar_Click"/>
                    </Grid>

                    <!-- ================================================= -->
                    <!-- NAVEGACIÓN                                        -->
                    <!-- ================================================= -->

                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">

                        <StackPanel Margin="12,0">
                            <StackPanel.Resources>
                                <Style TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
                                    <Setter Property="FontSize" Value="13"/>
                                    <Setter Property="Padding" Value="12,6"/>
                                </Style>
                            </StackPanel.Resources>

                            <!-- PRINCIPAL -->
                            <TextBlock Text="PRINCIPAL"
                                       Margin="10,0,0,8"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextMutedBrush}"/>

                            <Button Content="🏠   Panel principal"
                                    Command="{Binding NavigateCommand}"
                                    CommandParameter="Dashboard"
                                    Style="{StaticResource NavButtonStyle}"/>

                            <Button Content="🖥️   Mi PC"
                                    Command="{Binding NavigateCommand}"
                                    CommandParameter="RevisarPC"
                                    Style="{StaticResource NavButtonStyle}"/>

                            <!-- DIAGNÓSTICO -->
                            <TextBlock Text="DIAGNÓSTICO"
                                       Margin="10,20,0,8"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextMutedBrush}"/>

                            <Button Content="🔋   Batería"
                                    Command="{Binding NavigateCommand}"
                                    CommandParameter="Batería"
                                    Style="{StaticResource NavButtonStyle}"/>

                            <Button Content="⚡   Benchmark"
                                    Command="{Binding NavigateCommand}"
                                    CommandParameter="Benchmark"
                                    Style="{StaticResource NavButtonStyle}"/>

                            <Button Content="🧩   Drivers"
                                    Command="{Binding NavigateCommand}"
                                    CommandParameter="Drivers"
                                    Style="{StaticResource NavButtonStyle}"/>

                            <Button Content="💾   Salud de discos"
                                    Command="{Binding NavigateCommand}"
                                    CommandParameter="SaludDiscos"
                                    Style="{StaticResource NavButtonStyle}"/>

                            <Button Content="🔌   Verificar USB"
                                    Command="{Binding NavigateCommand}"
                                    CommandParameter="VerificarUSB"
                                    Style="{StaticResource NavButtonStyle}"/>

                            <Button Content="🖱️   Periféricos"
                                    Command="{Binding NavigateCommand}"
                                    CommandParameter="Periféricos"
                                    Style="{StaticResource NavButtonStyle}"/>

                            <Button Content="🌐   Test de red"
                                    Command="{Binding NavigateCommand}"
                                    CommandParameter="TestRed"
                                    Style="{StaticResource NavButtonStyle}"/>

                            <Button Content="🔧   Reparar Windows"
                                    Command="{Binding NavigateCommand}"
                                    CommandParameter="RepararWindows"
                                    Style="{StaticResource NavButtonStyle}"/>

                            <Button Content="🪟   Compatibilidad Win 11"
                                    Command="{Binding NavigateCommand}"
                                    CommandParameter="CompatibilidadWin11"
                                    Style="{StaticResource NavButtonStyle}"/>

                            <!-- MANTENIMIENTO -->
                            <TextBlock Text="MANTENIMIENTO"
                                       Margin="10,20,0,8"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextMutedBrush}"/>

                            <Button Content="📄   Archivos duplicados"
                                    Command="{Binding NavigateCommand}"
                                    CommandParameter="ArchivosDuplicados"
                                    Style="{StaticResource NavButtonStyle}"/>

                            <Button Content="🧹   Limpieza"
                                    Command="{Binding NavigateCommand}"
                                    CommandParameter="Limpieza"
                                    Style="{StaticResource NavButtonStyle}"/>

                            <Button Content="🗺️   Mapa del disco"
                                    Command="{Binding NavigateCommand}"
                                    CommandParameter="MapaEspacio"
                                    Style="{StaticResource NavButtonStyle}"/>

                            <Button Content="📦   Aplicaciones instaladas"
                                    Command="{Binding NavigateCommand}"
                                    CommandParameter="Desinstalador"
                                    Style="{StaticResource NavButtonStyle}"/>

                            <Button Content="📦   Programas y actualizaciones"
                                    Command="{Binding NavigateCommand}"
                                    CommandParameter="ProgramasActualizar"
                                    Style="{StaticResource NavButtonStyle}"/>

                            <Button Content="🚀   Inicio de Windows"
                                    Command="{Binding NavigateCommand}"
                                    CommandParameter="InicioWindows"
                                    Style="{StaticResource NavButtonStyle}"/>

                            <!-- OPTIMIZACIÓN -->
                            <TextBlock Text="OPTIMIZACIÓN"
                                       Margin="10,20,0,8"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextMutedBrush}"/>

                            <Button Content="⚙️   Optimizaciones"
                                    Command="{Binding NavigateCommand}"
                                    CommandParameter="Optimizaciones"
                                    Style="{StaticResource NavButtonStyle}"/>

                            <Button Content="🔒   Privacidad"
                                    Command="{Binding NavigateCommand}"
                                    CommandParameter="Privacidad"
                                    Style="{StaticResource NavButtonStyle}"/>

                            <Button Content="🎮   Rendimiento"
                                    Command="{Binding NavigateCommand}"
                                    CommandParameter="Rendimiento"
                                    Style="{StaticResource NavButtonStyle}"/>

                            <Button Content="↩️   Central Deshacer"
                                    Command="{Binding NavigateCommand}"
                                    CommandParameter="CentralDeshacer"
                                    Style="{StaticResource NavButtonStyle}"/>

                            <Button Content="💿   Puntos de restauración"
                                    Command="{Binding NavigateCommand}"
                                    CommandParameter="PuntosRestauracion"
                                    Style="{StaticResource NavButtonStyle}"/>

                            <!-- BACKUP -->
                            <TextBlock Text="BACKUP &amp; RESTAURACIÓN"
                                       Margin="10,20,0,8"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextMutedBrush}"/>

                            <Button Content="💽   Backup para formatear"
                                    Command="{Binding NavigateCommand}"
                                    CommandParameter="BackupFormatear"
                                    Style="{StaticResource NavButtonStyle}"/>

                            <Button Content="🔧   Post-formateo"
                                    Command="{Binding NavigateCommand}"
                                    CommandParameter="PostFormateo"
                                    Style="{StaticResource NavButtonStyle}"/>

                            <!-- SISTEMA -->
                            <TextBlock Text="SISTEMA"
                                       Margin="10,20,0,8"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextMutedBrush}"/>

                            <Button Content="📋   Historial"
                                    Command="{Binding NavigateCommand}"
                                    CommandParameter="Historial"
                                    Style="{StaticResource NavButtonStyle}"/>

                            <!-- ESCÁNER INTELIGENTE -->
                            <TextBlock Text="DIAGNÓSTICO"
                                       Margin="10,20,0,8"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextMutedBrush}"/>

                            <Button Content="🔬   Escáner Inteligente"
                                    Command="{Binding NavigateCommand}"
                                    CommandParameter="Escaneo"
                                    Style="{StaticResource NavButtonStyle}"/>

                            <Button Content="⚙️   Configuración"
                                    Command="{Binding NavigateCommand}"
                                    CommandParameter="Configuracion"
                                    Style="{StaticResource NavButtonStyle}"/>
                                    Style="{StaticResource NavButtonStyle}"/>

                            <Button Content="ℹ️   Acerca de"
                                    Command="{Binding NavigateCommand}"
                                    CommandParameter="AcercaDe"
                                    Style="{StaticResource NavButtonStyle}"/>

                            <Button Content="🔤   Tamaño de letra"
                                    Command="{Binding NavigateCommand}"
                                    CommandParameter="Escala"
                                    Style="{StaticResource NavButtonStyle}"/>

                        </StackPanel>

                    </ScrollViewer>

                    <!-- ================================================= -->
                    <!-- PARTE INFERIOR                                    -->
                    <!-- ================================================= -->

                    <StackPanel Grid.Row="2"
                                Margin="12,10,12,16">

                        <Border Margin="8,10,8,0"
                                Padding="10"
                                CornerRadius="8"
                                Background="{DynamicResource BackgroundBrush}">

                            <StackPanel>
                                <TextBlock Text="{Binding ApplicationVersionLabel}"
                                           FontSize="10"
                                           Foreground="{DynamicResource TextMutedBrush}"/>

                                <TextBlock Text="Suite integral de mantenimiento."
                                           Margin="0,3,0,0"
                                           FontSize="10"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>

                        </Border>

                    </StackPanel>

                </Grid>

            </Border>


            <!-- ========================================================= -->
            <!-- CONTENIDO                                                 -->
            <!-- ========================================================= -->

            <Grid Grid.Column="1">

                <Grid.RowDefinitions>
                    <RowDefinition Height="72"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>


                <!-- ===================================================== -->
                <!-- HEADER                                                -->
                <!-- ===================================================== -->

                <Border Grid.Row="0"
                        Background="{DynamicResource BackgroundBrush}"
                        BorderBrush="{DynamicResource BorderSubtleBrush}"
                        BorderThickness="0,0,0,1">

                    <Grid Margin="28,0">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="WPC-SutilBox"
                                       FontSize="13"
                                       Foreground="{DynamicResource TextMutedBrush}"/>

                            <TextBlock Text="{Binding CurrentSectionTitle}"
                                       Margin="0,2,0,0"
                                       FontSize="21"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </StackPanel>


                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">

                            <!-- INDICADOR DE ESTADO -->
                            <Border Padding="10,6"
                                    Margin="0,0,10,0"
                                    CornerRadius="8"
                                    Background="{DynamicResource SurfaceElevatedBrush}">

                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="7"
                                             Height="7"
                                             Margin="0,0,7,0"
                                             Fill="{DynamicResource SuccessBrush}"
                                             VerticalAlignment="Center"/>

                                    <TextBlock Text="Sistema listo"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </StackPanel>

                            </Border>

                            <!-- BOTÓN DE AJUSTES -->
                            <Button Width="38"
                                    Height="38"
                                    Content="⚙"
                                    ToolTip="Configuración"
                                    Command="{Binding NavigateCommand}"
                                    CommandParameter="Configuracion"
                                    Background="{DynamicResource SurfaceElevatedBrush}"
                                    Foreground="{DynamicResource TextSecondaryBrush}"
                                    BorderThickness="0"
                                    Cursor="Hand"/>

                        </StackPanel>

                    </Grid>

                </Border>


                <!-- ===================================================== -->
                <!-- BARRA DE CARGA                                        -->
                <!-- ===================================================== -->

                <ProgressBar Grid.Row="1"
                             Height="2"
                             IsIndeterminate="True"
                             Background="Transparent"
                             BorderThickness="0"
                             Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"
                             VerticalAlignment="Top"
                             Panel.ZIndex="100"/>


                <!-- ===================================================== -->
                <!-- ÁREA DE VISTAS                                        -->
                <!-- ===================================================== -->

                <Grid Grid.Row="2"
                      Margin="28,24,28,28"
                      ClipToBounds="True">

                    <!-- 1. Panel principal -->
                    <views:DashboardView DataContext="{Binding DashboardViewModel}"
                        Visibility="{Binding DataContext.CurrentSection, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter={x:Static enums:AppSection.Dashboard}}"/>

                    <!-- 2. Mi PC -->
                    <views:PcReviewView DataContext="{Binding PcReviewViewModel}"
                        Visibility="{Binding DataContext.CurrentSection, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter={x:Static enums:AppSection.RevisarPC}}"/>

                    <!-- 3. Batería -->
                    <views:BatteryView DataContext="{Binding BatteryViewModel}"
                        Visibility="{Binding DataContext.CurrentSection, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter={x:Static enums:AppSection.Batería}}"/>

                    <!-- 4. Benchmark -->
                    <views:BenchmarkView DataContext="{Binding BenchmarkViewModel}"
                        Visibility="{Binding DataContext.CurrentSection, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter={x:Static enums:AppSection.Benchmark}}"/>

                    <!-- 5. Drivers -->
                    <views:DriversView DataContext="{Binding DriversViewModel}"
                        Visibility="{Binding DataContext.CurrentSection, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter={x:Static enums:AppSection.Drivers}}"/>

                    <!-- 6. Salud de discos -->
                    <views:DiskHealthView DataContext="{Binding StorageViewModel}"
                        Visibility="{Binding DataContext.CurrentSection, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter={x:Static enums:AppSection.SaludDiscos}}"/>

                    <!-- 7. Verificar USB -->
                    <views:UsbStorageView DataContext="{Binding UsbStorageViewModel}"
                        Visibility="{Binding DataContext.CurrentSection, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter={x:Static enums:AppSection.VerificarUSB}}"/>

                    <!-- 8. Periféricos -->
                    <views:PeripheralDiagnosticsView DataContext="{Binding PeripheralDiagnosticsViewModel}"
                        Visibility="{Binding DataContext.CurrentSection, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter={x:Static enums:AppSection.Periféricos}}"/>

                    <!-- 9. Test de red -->
                    <views:NetworkView DataContext="{Binding NetworkTestViewModel}"
                        Visibility="{Binding DataContext.CurrentSection, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter={x:Static enums:AppSection.TestRed}}"/>

                    <!-- 10. Reparar Windows -->
                    <views:DiagnosticView
                        Visibility="{Binding DataContext.CurrentSection, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter={x:Static enums:AppSection.RepararWindows}}"/>

                    <!-- 11. Compatibilidad Win 11 -->
                    <views:Windows11CompatibilityView DataContext="{Binding Windows11CompatibilityViewModel}"
                        Visibility="{Binding DataContext.CurrentSection, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter={x:Static enums:AppSection.CompatibilidadWin11}}"/>

                    <!-- 12. Archivos duplicados -->
                    <views:DuplicateFilesView DataContext="{Binding DuplicateFilesViewModel}"
                        Visibility="{Binding DataContext.CurrentSection, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter={x:Static enums:AppSection.ArchivosDuplicados}}"/>

                    <!-- 13. Limpieza -->
                    <views:CleanupView DataContext="{Binding CleanupViewModel}"
                        Visibility="{Binding DataContext.CurrentSection, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter={x:Static enums:AppSection.Limpieza}}"/>

                    <!-- 14. Mapa del disco -->
                    <views:SpaceMapView DataContext="{Binding SpaceMapViewModel}"
                        Visibility="{Binding DataContext.CurrentSection, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter={x:Static enums:AppSection.MapaEspacio}}"/>

                    <!-- 15. Almacenamiento (escaneo) -->
                    <views:CleaningView DataContext="{Binding StorageViewModel}"
                        Visibility="{Binding DataContext.CurrentSection, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter={x:Static enums:AppSection.Almacenamiento}}"/>

                    <!-- 16. Desinstalador -->
                    <views:AplicacionesView DataContext="{Binding ProgramsViewModel}"
                        Visibility="{Binding DataContext.CurrentSection, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter={x:Static enums:AppSection.Desinstalador}}"/>

                    <!-- 18. Programas y actualizaciones -->
                    <views:ActualizacionesView DataContext="{Binding ProgramsViewModel}"
                        Visibility="{Binding DataContext.CurrentSection, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter={x:Static enums:AppSection.ProgramasActualizar}}"/>

                    <!-- 20. Inicio de Windows -->
                    <views:StartupManagerView DataContext="{Binding StartupViewModel}"
                        Visibility="{Binding DataContext.CurrentSection, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter={x:Static enums:AppSection.InicioWindows}}"/>

                    <!-- 21. Optimizaciones -->
                    <views:OptimizationView
                        Visibility="{Binding DataContext.CurrentSection, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter={x:Static enums:AppSection.Optimizaciones}}"/>

                    <!-- 22. Privacidad -->
                    <views:PrivacyView DataContext="{Binding PrivacyViewModel}"
                        Visibility="{Binding DataContext.CurrentSection, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter={x:Static enums:AppSection.Privacidad}}"/>

                    <!-- 23. Rendimiento -->
                    <views:RendimientoView
                        Visibility="{Binding DataContext.CurrentSection, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter={x:Static enums:AppSection.Rendimiento}}"/>

                    <!-- 24. Central Deshacer -->
                    <views:HistoryView DataContext="{Binding HistoryViewModel}"
                        Visibility="{Binding DataContext.CurrentSection, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter={x:Static enums:AppSection.CentralDeshacer}}"/>

                    <!-- 25. Puntos de restauración -->
                    <views:RestorePointView DataContext="{Binding RestorePointViewModel}"
                        Visibility="{Binding DataContext.CurrentSection, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter={x:Static enums:AppSection.PuntosRestauracion}}"/>

                    <!-- 26. Backup para formatear -->
                    <views:BackupView
                        Visibility="{Binding DataContext.CurrentSection, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter={x:Static enums:AppSection.BackupFormatear}}"/>

                    <!-- 27. Post-formateo -->
                    <views:RestoreView
                        Visibility="{Binding DataContext.CurrentSection, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter={x:Static enums:AppSection.PostFormateo}}"/>

                    <!-- 28. Herramientas -->
                    <views:ToolboxView
                        Visibility="{Binding DataContext.CurrentSection, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter={x:Static enums:AppSection.Herramientas}}"/>

                    <!-- 30. Historial -->
                    <views:HistoryLogView
                        Visibility="{Binding DataContext.CurrentSection, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter={x:Static enums:AppSection.Historial}}"/>

                    <!-- 31. Configuración -->
                    <views:SettingsView
                        Visibility="{Binding DataContext.CurrentSection, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter={x:Static enums:AppSection.Configuracion}}"/>

                    <!-- 32. Editor de perfiles -->
                    <views:ProfileEditorView DataContext="{Binding ProfileEditorViewModel}"
                        Visibility="{Binding DataContext.CurrentSection, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter={x:Static enums:AppSection.EditorPerfiles}}"/>

                    <!-- 33. Acerca de -->
                    <views:PlaceholderView Title="ℹ️ Acerca de" Description="{Binding DataContext.AboutDescription, RelativeSource={RelativeSource AncestorType=Window}}" SectionName="AcercaDe" ShowDevelopmentNotice="False"
                        Visibility="{Binding DataContext.CurrentSection, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter={x:Static enums:AppSection.AcercaDe}}"/>

                    <!-- 34. Escala -->
                    <views:SettingsView
                        Visibility="{Binding DataContext.CurrentSection, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter={x:Static enums:AppSection.Escala}}/>

                    <views:SmartScannerView Grid.Row="0" Grid.Column="0"
                        Visibility="{Binding CurrentSection, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter={x:Static enums:AppSection.Escaneo}}/>

                </Grid>


                <!-- ===================================================== -->
                <!-- ESTADO                                                -->
                <!-- ===================================================== -->

                <Border Grid.Row="2"
                        VerticalAlignment="Bottom"
                        HorizontalAlignment="Right"
                        Margin="0,0,28,16"
                        Padding="10,6"
                        CornerRadius="7"
                        Background="{DynamicResource SurfaceElevatedBrush}"
                        Opacity="0.92"
                        Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">

                    <TextBlock Text="{Binding StatusMessage}"
                               FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>

                </Border>

            </Grid>

        </Grid>

    </Border>

</Window>
