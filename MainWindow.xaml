<Window x:Class="Wpc_SutilBox.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:Wpc_SutilBox.Views"
        mc:Ignorable="d"
        Title="WPC-SutilBox"
        Height="700"
        Width="1180"
        MinHeight="560"
        MinWidth="900"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResize"
        WindowState="Normal"
        WindowStartupLocation="CenterScreen"
        ShowActivated="True"
        Icon="Resources/img/logo_WCS.ico"
        Background="{DynamicResource BackgroundBrush}">

    <Border Background="{DynamicResource BackgroundBrush}">

        <Grid>

            <!-- ========================================================= -->
            <!-- ESTRUCTURA PRINCIPAL                                      -->
            <!-- ========================================================= -->

            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn"
                                  Width="235"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ========================================================= -->
            <!-- SIDEBAR                                                   -->
            <!-- ========================================================= -->

            <Border Grid.Column="0"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                    BorderThickness="0,0,1,0">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- LOGO -->
                    
                    <!-- BOTÓN CONTRAER -->
                    
                    <Grid Grid.Row="0"
                        Margin="18,18,18,28">
                        
                        <Button Width="36"
                            Height="36"
                            HorizontalAlignment="Right"
                            Content="☰"
                            ToolTip="Expandir / contraer menú"
                            Background="{DynamicResource SurfaceElevatedBrush}"
                            Foreground="{DynamicResource TextSecondaryBrush}"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="ToggleSidebar_Click"/>
                            </Grid>

                    <!-- ================================================= -->
                    <!-- NAVEGACIÓN                                         -->
                    <!-- ================================================= -->

                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">

                        <StackPanel Margin="12,0">

                            <!-- GRUPO PRINCIPAL -->

                            <TextBlock Text="PRINCIPAL"
                                       Margin="10,0,0,8"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextMutedBrush}"/>

                            <Button Content="⌂  Inicio"
                                    Command="{Binding NavigateCommand}"
                                    CommandParameter="Dashboard"
                                    Style="{StaticResource NavButtonStyle}"/>

                            <Button Content="◈  Protección"
                                    Command="{Binding NavigateCommand}"
                                    CommandParameter="Proteccion"
                                    Style="{StaticResource NavButtonStyle}"/>

                            <Button Content="⚡  Rendimiento"
                                    Command="{Binding NavigateCommand}"
                                    CommandParameter="Rendimiento"
                                    Style="{StaticResource NavButtonStyle}"/>

                            <Button Content="▣  Almacenamiento"
                                    Command="{Binding NavigateCommand}"
                                    CommandParameter="Almacenamiento"
                                    Style="{StaticResource NavButtonStyle}"/>

                            <!-- SISTEMA -->

                            <TextBlock Text="SISTEMA"
                                       Margin="10,24,0,8"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextMutedBrush}"/>

                            <Button Content="▦  Aplicaciones"
                                    Command="{Binding NavigateCommand}"
                                    CommandParameter="Aplicaciones"
                                    Style="{StaticResource NavButtonStyle}"/>

                            <Button Content="▣  Hardware"
                                    Command="{Binding NavigateCommand}"
                                    CommandParameter="Hardware"
                                    Style="{StaticResource NavButtonStyle}"/>

                            <!-- HERRAMIENTAS -->

                            <TextBlock Text="HERRAMIENTAS"
                                       Margin="10,24,0,8"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextMutedBrush}"/>

                            <Button Content="⚒  Caja de herramientas"
                                    Command="{Binding NavigateCommand}"
                                    CommandParameter="Herramientas"
                                    Style="{StaticResource NavButtonStyle}"/>

                            <!-- PREPARACIÓN FUTURA -->

                            <Border Margin="8,22,8,8"
                                    Padding="12"
                                    CornerRadius="10"
                                    Background="{DynamicResource SurfaceElevatedBrush}">

                                <StackPanel>

                                    <TextBlock Text="PRÓXIMAMENTE"
                                               FontSize="9"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource PrimaryBrush}"/>

                                    <TextBlock Text="Más módulos llegarán a SutilBox."
                                               Margin="0,5,0,0"
                                               FontSize="11"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>

                                </StackPanel>

                            </Border>

                        </StackPanel>

                    </ScrollViewer>

                    <!-- ================================================= -->
                    <!-- PARTE INFERIOR                                    -->
                    <!-- ================================================= -->

                    <StackPanel Grid.Row="2"
                                Margin="12,10,12,16">

                        <Button Content="⚙  Configuración"
                                Command="{Binding NavigateCommand}"
                                CommandParameter="Configuracion"
                                Style="{StaticResource NavButtonStyle}"/>

                        <Border Margin="8,10,8,0"
                                Padding="10"
                                CornerRadius="8"
                                Background="{DynamicResource BackgroundBrush}">

                            <StackPanel>

                                <TextBlock Text="WPC-SutilBox Beta.1"
                                           FontSize="10"
                                           Foreground="{DynamicResource TextMutedBrush}"/>

                                <TextBlock Text="Construyendo una suite todo-en-uno."
                                           Margin="0,3,0,0"
                                           FontSize="10"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>

                            </StackPanel>

                        </Border>

                    </StackPanel>

                </Grid>

            </Border>


            <!-- ========================================================= -->
            <!-- CONTENIDO                                                 -->
            <!-- ========================================================= -->

            <Grid Grid.Column="1">

                <Grid.RowDefinitions>
                    <RowDefinition Height="72"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>


                <!-- ===================================================== -->
                <!-- HEADER                                                -->
                <!-- ===================================================== -->

                <Border Grid.Row="0"
                        Background="{DynamicResource BackgroundBrush}"
                        BorderBrush="{DynamicResource BorderSubtleBrush}"
                        BorderThickness="0,0,0,1">

                    <Grid Margin="28,0">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center">

                            <TextBlock Text="WPC-SutilBox"
                                       FontSize="13"
                                       Foreground="{DynamicResource TextMutedBrush}"/>

                            <TextBlock Text="Centro de control"
                                       Margin="0,2,0,0"
                                       FontSize="21"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>

                        </StackPanel>


                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">

                            <!-- INDICADOR DE ESTADO -->

                            <Border Padding="10,6"
                                    Margin="0,0,10,0"
                                    CornerRadius="8"
                                    Background="{DynamicResource SurfaceElevatedBrush}">

                                <StackPanel Orientation="Horizontal">

                                    <Ellipse Width="7"
                                             Height="7"
                                             Margin="0,0,7,0"
                                             Fill="{DynamicResource SuccessBrush}"
                                             VerticalAlignment="Center"/>

                                    <TextBlock Text="Sistema listo"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>

                                </StackPanel>

                            </Border>

                            <!-- BOTÓN DE AJUSTES -->

                            <Button Width="38"
                                    Height="38"
                                    Content="⚙"
                                    ToolTip="Configuración"
                                    Command="{Binding NavigateCommand}"
                                    CommandParameter="Configuracion"
                                    Background="{DynamicResource SurfaceElevatedBrush}"
                                    Foreground="{DynamicResource TextSecondaryBrush}"
                                    BorderThickness="0"
                                    Cursor="Hand"/>

                        </StackPanel>

                    </Grid>

                </Border>


                <!-- ===================================================== -->
                <!-- BARRA DE CARGA                                        -->
                <!-- ===================================================== -->

                <ProgressBar Grid.Row="1"
                             Height="2"
                             IsIndeterminate="True"
                             Background="Transparent"
                             BorderThickness="0"
                             Visibility="{Binding IsBusy,
                                 Converter={StaticResource BooleanToVisibilityConverter}}"
                             VerticalAlignment="Top"
                             Panel.ZIndex="100"/>


                <!-- ===================================================== -->
                <!-- ÁREA DE VISTAS                                        -->
                <!-- ===================================================== -->

                <Grid Grid.Row="2"
                      Margin="28,24,28,28"
                      ClipToBounds="True">

                    <views:DashboardView
                        Visibility="{Binding CurrentSection,
                            Converter={StaticResource EnumToVisibilityConverter},
                            ConverterParameter=Dashboard}"/>

                    <views:SecurityView
                        Visibility="{Binding CurrentSection,
                            Converter={StaticResource EnumToVisibilityConverter},
                            ConverterParameter=Proteccion}"/>

                    <views:CleaningView
                        Visibility="{Binding CurrentSection,
                            Converter={StaticResource EnumToVisibilityConverter},
                            ConverterParameter=Almacenamiento}"/>

                    <views:RendimientoView
                        Visibility="{Binding CurrentSection,
                            Converter={StaticResource EnumToVisibilityConverter},
                            ConverterParameter=Rendimiento}"/>

                    <views:ProfileEditorView
                        Visibility="{Binding CurrentSection,
                            Converter={StaticResource EnumToVisibilityConverter},
                            ConverterParameter=EditorPerfiles}"/>

                    <views:AplicacionesView
                        Visibility="{Binding CurrentSection,
                            Converter={StaticResource EnumToVisibilityConverter},
                            ConverterParameter=Aplicaciones}"/>

                    <views:HardwareView
                        Visibility="{Binding CurrentSection,
                            Converter={StaticResource EnumToVisibilityConverter},
                            ConverterParameter=Hardware}"/>

                    <views:ToolboxView
                        Visibility="{Binding CurrentSection,
                            Converter={StaticResource EnumToVisibilityConverter},
                            ConverterParameter=Herramientas}"/>

                    <views:SettingsView
                        Visibility="{Binding CurrentSection,
                            Converter={StaticResource EnumToVisibilityConverter},
                            ConverterParameter=Configuracion}"/>

                </Grid>


                <!-- ===================================================== -->
                <!-- ESTADO                                                -->
                <!-- ===================================================== -->

                <Border Grid.Row="2"
                        VerticalAlignment="Bottom"
                        HorizontalAlignment="Right"
                        Margin="0,0,28,16"
                        Padding="10,6"
                        CornerRadius="7"
                        Background="{DynamicResource SurfaceElevatedBrush}"
                        Opacity="0.92"
                        Visibility="{Binding IsBusy,
                            Converter={StaticResource BooleanToVisibilityConverter}}">

                    <TextBlock Text="{Binding StatusMessage}"
                               FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>

                </Border>

            </Grid>

        </Grid>

    </Border>

</Window>