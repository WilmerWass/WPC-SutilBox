<Window x:Class="Wpc_SutilBox.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:Wpc_SutilBox.Views"
        mc:Ignorable="d"
        Title="WPC-SutilBox"
        Height="700"
        Width="1180"
        MinHeight="560"
        MinWidth="900"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResize"
        WindowState="Normal"
        WindowStartupLocation="CenterScreen"
        ShowActivated="True"
        Icon="Resources/img/logo_WCS.ico"
        Background="{DynamicResource BackgroundBrush}">

    <Border Background="{DynamicResource BackgroundBrush}">

        <Grid>

            <!-- ========================================================= -->
            <!-- ESTRUCTURA PRINCIPAL                                      -->
            <!-- ========================================================= -->

            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="235"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ========================================================= -->
            <!-- SIDEBAR ÚNICO Y UNIFICADO                                 -->
            <!-- ========================================================= -->

            <Border Grid.Column="0"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                    BorderThickness="0,0,1,0">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- BOTÓN CONTRAER / EXPANDIR -->
                    <Grid Grid.Row="0" Margin="18,18,18,12">
                        <TextBlock Text="WPC SutilBox" 
                                   FontSize="16" 
                                   FontWeight="Bold" 
                                   Foreground="{DynamicResource TextPrimaryBrush}" 
                                   VerticalAlignment="Center" 
                                   HorizontalAlignment="Left"/>
                        
                        <Button Width="36"
                                Height="36"
                                HorizontalAlignment="Right"
                                Content="☰"
                                ToolTip="Expandir / contraer menú"
                                Background="{DynamicResource SurfaceElevatedBrush}"
                                Foreground="{DynamicResource TextSecondaryBrush}"
                                BorderThickness="0"
                                Cursor="Hand"
                                Click="ToggleSidebar_Click"/>
                    </Grid>

                    <!-- ================================================= -->
                    <!-- NAVEGACIÓN                                        -->
                    <!-- ================================================= -->

                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Hidden"
                                  HorizontalScrollBarVisibility="Disabled">

                        <StackPanel Margin="12,0">
                            <StackPanel.Resources>
                                <Style TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
                                    <Setter Property="FontSize" Value="13"/>
                                    <Setter Property="Padding" Value="12,6"/>
                                </Style>
                            </StackPanel.Resources>

                            <!-- GRUPO PRINCIPAL -->
                            <TextBlock Text="PRINCIPAL"
                                       Margin="10,0,0,8"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextMutedBrush}"/>

                            <Button Content="🏠   Inicio"
                                    Command="{Binding NavigateCommand}"
                                    CommandParameter="Dashboard"
                                    Style="{StaticResource NavButtonStyle}"/>
                            <Button Content="Revisar mi PC" Command="{Binding NavigateCommand}" CommandParameter="RevisarPC" Style="{StaticResource NavButtonStyle}"/>
                            <StackPanel Margin="28,0,0,0">
                                <Button Content="Resumen de salud" Command="{Binding NavigateCommand}" CommandParameter="RevisarPC" Style="{StaticResource NavButtonStyle}"/>
                                <Button Content="Espacio y almacenamiento" Command="{Binding NavigateCommand}" CommandParameter="RevisarPC" Style="{StaticResource NavButtonStyle}"/>
                                <Button Content="Hardware y temperaturas" Command="{Binding NavigateCommand}" CommandParameter="RevisarPC" Style="{StaticResource NavButtonStyle}"/>
                                <Button Content="Procesos de alto consumo" Command="{Binding NavigateCommand}" CommandParameter="RevisarPC" Style="{StaticResource NavButtonStyle}"/>
                            </StackPanel>

                            <Button Content="🧹   Liberar espacio"
                                    Command="{Binding NavigateCommand}"
                                    CommandParameter="Almacenamiento"
                                    Style="{StaticResource NavButtonStyle}"/>

                            <!-- GESTIÓN -->
                            <TextBlock Text="GESTIÓN"
                                       Margin="10,20,0,8"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextMutedBrush}"/>

                            <Button Content="📦   Aplicaciones"
                                    Command="{Binding NavigateCommand}"
                                    CommandParameter="Aplicaciones"
                                    Style="{StaticResource NavButtonStyle}"/>

                            <Button Content="🎮   Juegos"
                                    Command="{Binding NavigateCommand}"
                                    CommandParameter="Juegos"
                                    Style="{StaticResource NavButtonStyle}"/>

                            <Button Content="⚡   Rendimiento"
                                    Command="{Binding NavigateCommand}"
                                    CommandParameter="Rendimiento"
                                    Style="{StaticResource NavButtonStyle}"/>

                            <!-- PROTECCIÓN & PRIVACIDAD -->
                            <TextBlock Text="SEGURIDAD Y SISTEMA"
                                       Margin="10,20,0,8"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextMutedBrush}"/>

                            <Button Content="🛡️   Seguridad"
                                    Command="{Binding NavigateCommand}"
                                    CommandParameter="Proteccion"
                                    Style="{StaticResource NavButtonStyle}"/>

                            <Button Content="🔒   Privacidad"
                                    Command="{Binding NavigateCommand}"
                                    CommandParameter="Privacidad"
                                    Style="{StaticResource NavButtonStyle}"/>

                            <Button Content="🎨   Personalización"
                                    Command="{Binding NavigateCommand}"
                                    CommandParameter="EditorPerfiles"
                                    Style="{StaticResource NavButtonStyle}"/>

                            <Button Content="🔄   Windows Update"
                                    Command="{Binding NavigateCommand}"
                                    CommandParameter="Actualizaciones"
                                    Style="{StaticResource NavButtonStyle}"/>

                            <!-- HERRAMIENTAS & RED -->
                            <TextBlock Text="HERRAMIENTAS &amp; RED"
                                       Margin="10,20,0,8"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextMutedBrush}"/>

                            <Button Content="🧩   Drivers"
                                    Command="{Binding NavigateCommand}"
                                    CommandParameter="Drivers"
                                    Style="{StaticResource NavButtonStyle}"/>

                            <Button Content="🌐   Red"
                                    Command="{Binding NavigateCommand}"
                                    CommandParameter="Red"
                                    Style="{StaticResource NavButtonStyle}"/>

                            <Button Content="🔧   Reparación"
                                    Command="{Binding NavigateCommand}"
                                    CommandParameter="Reparacion"
                                    Style="{StaticResource NavButtonStyle}"/>

                            <Button Content="🛠️   Herramientas externas"
                                    Command="{Binding NavigateCommand}"
                                    CommandParameter="Herramientas"
                                    Style="{StaticResource NavButtonStyle}"/>

                            <Button Content="📋   Historial &amp; Logs"
                                    Command="{Binding NavigateCommand}"
                                    CommandParameter="Historial"
                                    Style="{StaticResource NavButtonStyle}"/>

                        </StackPanel>

                    </ScrollViewer>

                    <!-- ================================================= -->
                    <!-- PARTE INFERIOR                                    -->
                    <!-- ================================================= -->

                    <StackPanel Grid.Row="2"
                                Margin="12,10,12,16">

                        <Button Content="⚙   Configuración"
                                Command="{Binding NavigateCommand}"
                                CommandParameter="Configuracion"
                                Style="{StaticResource NavButtonStyle}"/>

                        <Border Margin="8,10,8,0"
                                Padding="10"
                                CornerRadius="8"
                                Background="{DynamicResource BackgroundBrush}">

                            <StackPanel>
                                <TextBlock Text="WPC-SutilBox Beta.1"
                                           FontSize="10"
                                           Foreground="{DynamicResource TextMutedBrush}"/>

                                <TextBlock Text="Construyendo una suite todo-en-uno."
                                           Margin="0,3,0,0"
                                           FontSize="10"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>

                        </Border>

                    </StackPanel>

                </Grid>

            </Border>


            <!-- ========================================================= -->
            <!-- CONTENIDO                                                 -->
            <!-- ========================================================= -->

            <Grid Grid.Column="1">

                <Grid.RowDefinitions>
                    <RowDefinition Height="72"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>


                <!-- ===================================================== -->
                <!-- HEADER                                                -->
                <!-- ===================================================== -->

                <Border Grid.Row="0"
                        Background="{DynamicResource BackgroundBrush}"
                        BorderBrush="{DynamicResource BorderSubtleBrush}"
                        BorderThickness="0,0,0,1">

                    <Grid Margin="28,0">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="WPC-SutilBox"
                                       FontSize="13"
                                       Foreground="{DynamicResource TextMutedBrush}"/>

                            <TextBlock Text="Centro de control"
                                       Margin="0,2,0,0"
                                       FontSize="21"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </StackPanel>


                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">

                            <!-- INDICADOR DE ESTADO -->
                            <Border Padding="10,6"
                                    Margin="0,0,10,0"
                                    CornerRadius="8"
                                    Background="{DynamicResource SurfaceElevatedBrush}">

                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="7"
                                             Height="7"
                                             Margin="0,0,7,0"
                                             Fill="{DynamicResource SuccessBrush}"
                                             VerticalAlignment="Center"/>

                                    <TextBlock Text="Sistema listo"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </StackPanel>

                            </Border>

                            <!-- BOTÓN DE AJUSTES -->
                            <Button Width="38"
                                    Height="38"
                                    Content="⚙"
                                    ToolTip="Configuración"
                                    Command="{Binding NavigateCommand}"
                                    CommandParameter="Configuracion"
                                    Background="{DynamicResource SurfaceElevatedBrush}"
                                    Foreground="{DynamicResource TextSecondaryBrush}"
                                    BorderThickness="0"
                                    Cursor="Hand"/>

                        </StackPanel>

                    </Grid>

                </Border>


                <!-- ===================================================== -->
                <!-- BARRA DE CARGA                                        -->
                <!-- ===================================================== -->

                <ProgressBar Grid.Row="1"
                             Height="2"
                             IsIndeterminate="True"
                             Background="Transparent"
                             BorderThickness="0"
                             Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"
                             VerticalAlignment="Top"
                             Panel.ZIndex="100"/>


                <!-- ===================================================== -->
                <!-- ÁREA DE VISTAS                                        -->
                <!-- ===================================================== -->

                <Grid Grid.Row="2"
                      Margin="28,24,28,28"
                      ClipToBounds="True">

                    <views:DashboardView
                        Visibility="{Binding CurrentSection, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=Dashboard}"/>

                    <views:PcReviewView
                        Visibility="{Binding CurrentSection, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=RevisarPC}"/>

                    <views:CleaningView
                        Visibility="{Binding CurrentSection, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=Almacenamiento}"/>

                    <views:AplicacionesView
                        Visibility="{Binding CurrentSection, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=Aplicaciones}"/>

                    <views:GamesView
                        Visibility="{Binding CurrentSection, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=Juegos}"/>

                    <views:RendimientoView
                        Visibility="{Binding CurrentSection, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=Rendimiento}"/>

                    <views:SecurityView
                        Visibility="{Binding CurrentSection, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=Proteccion}"/>

                    <views:PrivacyView
                        Visibility="{Binding CurrentSection, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=Privacidad}"/>

                    <views:ProfileEditorView
                        DataContext="{Binding ProfileEditorViewModel}"
                        Visibility="{Binding DataContext.CurrentSection, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=EditorPerfiles}"/>

                    <views:ActualizacionesView
                        Visibility="{Binding CurrentSection, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=Actualizaciones}"/>

                    <views:DriversView
                        Visibility="{Binding CurrentSection, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=Drivers}"/>

                    <views:NetworkView
                        Visibility="{Binding CurrentSection, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=Red}"/>

                    <views:DiagnosticView
                        Visibility="{Binding CurrentSection, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=Reparacion}"/>

                    <views:ToolboxView
                        Visibility="{Binding CurrentSection, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=Herramientas}"/>

                    <views:HistoryView
                        Visibility="{Binding CurrentSection, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=Historial}"/>

                    <views:SettingsView
                        Visibility="{Binding CurrentSection, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=Configuracion}"/>

                </Grid>


                <!-- ===================================================== -->
                <!-- ESTADO                                                -->
                <!-- ===================================================== -->

                <Border Grid.Row="2"
                        VerticalAlignment="Bottom"
                        HorizontalAlignment="Right"
                        Margin="0,0,28,16"
                        Padding="10,6"
                        CornerRadius="7"
                        Background="{DynamicResource SurfaceElevatedBrush}"
                        Opacity="0.92"
                        Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">

                    <TextBlock Text="{Binding StatusMessage}"
                               FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>

                </Border>

            </Grid>

        </Grid>

    </Border>

</Window>
